* text=auto

# Default: LF for code/config/docs (evita warnings LF<->CRLF en Windows)
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.env* text eol=lf

# Scripts Windows: CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

